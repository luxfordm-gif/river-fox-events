# Netlify response headers (speed pass, 2026-11-13).
#
# Everything in /assets/ (code, styles, photos) is named by the build with a
# fingerprint of its contents, so a changed file always gets a new name.
# Browsers can keep them for a year without re-checking each page load.
# Page HTML is not listed here, so it keeps Netlify's default (always
# re-checked), which is what makes a new release show straight away.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
